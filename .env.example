# Enquiry form (app/api/enquiry) — set these in Vercel → Project → Settings → Environment Variables.
#
# Required. Create at https://resend.com/api-keys with "Sending access".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Defaults shown. The FROM domain must be verified in Resend
# (Resend → Domains → add indusai.app and add the DNS records) or sends fail.
# ENQUIRY_TO_EMAIL=info@indusai.app
# ENQUIRY_FROM_EMAIL=Indus AI Website <enquiries@indusai.app>
